{
  "name": "shashank-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shashank Maheshwar's engineering portfolio: claims you can inspect, systems you can pull apart.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=a11y",
    "test:browsers": "playwright test --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "budget": "node scripts/budget.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "release:check": "RELEASE=1 astro build && node scripts/budget.mjs && node scripts/release-check.mjs",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "astro": "^7.4.13",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
