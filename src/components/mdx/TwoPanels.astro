---
interface Panel {
  title: string;
  items: string[];
}
interface Props {
  left: Panel;
  right: Panel;
}
const { left, right } = Astro.props;
---

<div class="two">
  {[left, right].map((p) => (
    <div class="panel">
      <p class="label">{p.title.toUpperCase()}</p>
      <ol>
        {p.items.map((i) => (
          <li>{i}</li>
        ))}
      </ol>
    </div>
  ))}
</div>
<style>
  .two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }
  @media (min-width: 768px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }
  .panel {
    border: var(--frame);
    background: var(--surface);
    padding: 14px 16px;
  }
  ol {
    margin-top: 8px;
    padding-left: 1.2em;
    font-size: 0.96875rem;
  }
</style>
