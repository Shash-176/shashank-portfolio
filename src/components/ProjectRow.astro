---
import type { CollectionEntry } from "astro:content";
import MiniMark from "./MiniMark.astro";
import State from "./State.astro";
import { getEvidence } from "@/lib/evidence";
interface Props {
  project: CollectionEntry<"projects">;
  tall?: boolean;
  index: number;
}
const { project, tall = project.data.depth === "full", index } = Astro.props;
const d = project.data;
const ev = await Promise.all(d.row.evidence.map((r) => getEvidence(r.id)));
const access = d.access === "public" ? "Public" : "Private";
const depth = d.depth === "full" ? (d.exhibit ? "Full case study + exhibit" : "Full case study") : "Short study";
---

<li class:list={["row", { tall }]}>
  <a class="hl-row" href={`/work/${project.id}`}>
    <span class="no">{String(index).padStart(2, "0")}</span>
    <span class="mark">
      <MiniMark mark={d.mark} size={tall ? 88 : 40} />
    </span>
    <span class="body">
      <span class="name hl-title" style={`view-transition-name: title-${project.id}`}>
        {d.name}
      </span>
      <span class="idea">{d.row.idea}</span>
      <span class="ev">
        {ev.map((e) => (
          <State state={e.state} word={e.short ?? e.claim} size={13} />
        ))}
      </span>
    </span>
    <span class="meta">
      <span class="label">
        {access}
        {d.row.note ? ` · ${d.row.note}` : ""}
      </span>
      <span class="depth">
        {depth}&nbsp;<span aria-hidden="true">→</span>
      </span>
    </span>
  </a>
</li>
<style>
  .row {
    border-bottom: var(--hair);
  }
  .row.tall {
    border-bottom: var(--frame);
  }
  a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px var(--s-4);
    padding: 16px 0;
    text-decoration: none;
    align-items: start;
  }
  .no,
  .mark {
    display: none;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    grid-column: 1 / -1;
  }
  .name {
    align-self: flex-start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .tall .name {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.375rem);
  }
  .tall .idea {
    font-size: 1.0625rem;
    max-width: 56ch;
  }
  .ev {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  .meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    align-items: baseline;
  }
  .depth {
    font-weight: 600;
    color: var(--link);
    white-space: nowrap;
  }
  .depth span {
    display: inline-block;
    transition: transform var(--t-fast) var(--ease-out);
  }
  a:hover .depth span,
  a:focus-visible .depth span {
    transform: translateX(4px);
  }
  .mark {
    transition: transform var(--t-ui) var(--ease-out);
  }
  a:hover .mark {
    transform: translateY(-2px);
  }
  @media (min-width: 768px) {
    a {
      grid-template-columns: 44px minmax(0, 1fr) 236px;
      gap: var(--s-5);
      padding: 18px 0;
      align-items: center;
    }
    .tall a {
      padding: 28px 0;
      align-items: start;
    }
    .no {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      color: var(--muted);
    }
    .body {
      grid-column: auto;
    }
    .meta {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
  @media (min-width: 1100px) {
    a {
      grid-template-columns: 44px 120px minmax(0, 1fr) 236px;
    }
    .mark {
      display: flex;
      justify-content: center;
    }
    .tall .mark {
      border: var(--hair);
      background: var(--surface);
      padding: 12px 0;
    }
  }
</style>
