---
/**
 * An inline claim with its evidence numeral. The layout numbers numerals by first use in the page
 * (src/lib/evidence-render.ts). Without JavaScript the numeral links to the page's evidence list.
 */
import { getEvidence } from "@/lib/evidence";
import { NUM } from "@/lib/evidence-render";
interface Props {
  id: string;
  mark?: boolean;
}
const { id, mark = true } = Astro.props;
const e = await getEvidence(id);
const n = NUM(id);
---

<span class:list={["claim", { stated: e.state === "Stated", plain: !mark }]}>
  <slot />
  <a class="ev-num" href={`#ev-${n}`} data-note={n} aria-label={`Evidence note ${n}, ${e.state.toLowerCase()}`}>
    [{n}]
  </a>
</span>
<style>
  .claim {
    transition:
      background-color var(--t-ui) var(--ease-out),
      box-shadow var(--t-ui) var(--ease-out);
  }
  .ev-num {
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 600;
    vertical-align: super;
    line-height: 0;
    margin-left: 2px;
    padding: 0 1px;
    color: var(--link);
    text-decoration: none;
    white-space: nowrap;
  }
  .ev-num {
    border-radius: var(--radius);
    transition:
      background-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }
  .ev-num:hover,
  .ev-num:focus-visible {
    background: var(--mark);
    color: var(--mark-ink);
  }
  :global(html[data-lens="on"]) .claim:not(.stated):not(.plain) {
    background: var(--hl);
    color: var(--hl-ink);
    box-shadow: inset 0 -2px 0 var(--hl-line);
    padding: 1px 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  :global(html[data-lens="on"]) .claim.stated {
    border-bottom: 1.5px dashed var(--muted);
  }
</style>
