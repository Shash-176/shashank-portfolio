---
import Text from "./Text.astro";
import { SITE } from "@/site";
import { hasPlaceholder } from "@/lib/rules";
interface Props {
  active?: "work" | "about" | "research";
}
const { active } = Astro.props;
const links = [
  { key: "work", href: "/work", label: "Work" },
  { key: "about", href: "/about", label: "About" },
  { key: "research", href: "/research", label: "Research" },
] as const;
const resumeHref = hasPlaceholder(SITE.resume.url) ? "/resume" : SITE.resume.url;
---

<header class="site-header page">
  <a class="brand" href="/">
    <img class="mk-l" src="/avatar/mark-light.svg" alt="" width="30" height="30" />
    <img class="mk-d" src="/avatar/mark-dark.svg" alt="" width="30" height="30" />
    <span class="full">{SITE.name}</span>
    <span class="short">{SITE.shortName}</span>
  </a>
  <nav aria-label="Primary" class="desk">
    {links.map((l) => (
      <a href={l.href} aria-current={active === l.key ? "page" : undefined}>
        {l.label}
      </a>
    ))}
  </nav>
  <div class="tools">
    <button type="button" class="btn lens desk" data-lens-toggle aria-pressed="false" aria-keyshortcuts="e">
      <span class="box" aria-hidden="true"></span>Evidence <span data-lens-state>off</span>
      <kbd aria-hidden="true">E</kbd>
    </button>
    <button type="button" class="btn icon desk" data-theme-toggle aria-label="Change theme">
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="10" cy="10" r="6.5"></circle>
        <path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
      </svg>
    </button>
    <a class="btn primary" href={resumeHref}>
      Résumé
    </a>
    <button
      type="button"
      class="btn icon phone"
      data-menu-open
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M3 6h14M3 10h14M3 14h14"></path>
      </svg>
    </button>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="Menu">
  <div class="menu-head">
    <span class="label">Menu</span>
    <button type="button" class="btn icon" data-menu-close aria-label="Close menu">
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Primary">
    {links.map((l) => (
      <a class="big" href={l.href} aria-current={active === l.key ? "page" : undefined}>
        {l.label}
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </nav>
  <p class="label">Evidence lens</p>
  <button type="button" class="btn lens wide" data-lens-toggle aria-pressed="false">
    <span class="box" aria-hidden="true"></span>Evidence <span data-lens-state>off</span>
  </button>
  <p class="label">Theme</p>
  <div role="radiogroup" aria-label="Theme" class="themes">
    {["system", "light", "dark"].map((m) => (
      <button type="button" role="radio" aria-checked={m === "system" ? "true" : "false"} data-theme-set={m}>
        {m[0].toUpperCase() + m.slice(1)}
      </button>
    ))}
  </div>
  <div class="contact">
    {hasPlaceholder(SITE.email) ? (
      <span class="btn">
        <Text value={SITE.email} />
      </span>
    ) : (
      <a class="btn" href={`mailto:${SITE.email}`}>
        Email
      </a>
    )}
    <a class="btn" href={SITE.github} rel="noopener noreferrer">
      GitHub ↗
    </a>
  </div>
</dialog>

<style>
  .mk-d {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .mk-l {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .mk-d {
      display: block;
    }
  }
  :global(:root[data-theme="dark"]) .mk-l {
    display: none;
  }
  :global(:root[data-theme="dark"]) .mk-d {
    display: block;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom: var(--frame);
  }
  @media (min-width: 768px) {
    .site-header {
      padding-top: 18px;
      padding-bottom: 18px;
    }
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }
  .brand img {
    width: 30px;
    height: 30px;
  }
  .short {
    display: none;
  }
  nav.desk {
    display: flex;
    gap: 26px;
    margin-left: auto;
    margin-right: var(--s-2);
  }
  nav.desk a {
    text-decoration: none;
    padding: 10px 0;
  }
  nav.desk a:hover {
    box-shadow: inset 0 -1px 0 var(--ink);
  }
  nav a[aria-current="page"] {
    font-weight: 600;
    box-shadow: inset 0 -3px 0 var(--chip) !important;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .icon {
    width: 44px;
    padding: 0;
    border-color: var(--rule);
  }
  .lens {
    font-size: 0.9375rem;
  }
  .box {
    width: 12px;
    height: 12px;
    border: 1px solid var(--ink);
  }
  :global(html[data-lens="on"]) .box {
    background: var(--chip);
  }
  kbd {
    font-size: 0.75rem;
    color: var(--muted);
    border: var(--hair);
    padding: 0 5px;
  }
  .phone {
    display: none;
  }
  @media (max-width: 899.98px) {
    nav.desk {
      gap: 18px;
    }
    .lens kbd {
      display: none;
    }
    .full {
      display: none;
    }
    .short {
      display: inline;
    }
  }
  @media (max-width: 767.98px) {
    .desk {
      display: none !important;
    }
    .phone {
      display: inline-flex;
    }
    .full {
      display: none;
    }
    .short {
      display: inline;
    }
  }
  .menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--s-3) var(--s-4) var(--s-5);
    border: 0;
    background: var(--bg);
    color: var(--ink);
  }
  .menu::backdrop {
    background: var(--scrim);
  }
  .menu-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--s-2);
    border-bottom: var(--frame);
  }
  .menu nav {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--s-5);
  }
  .big {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 68px;
    border-bottom: var(--hair);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.125rem;
  }
  .big[aria-current="page"] {
    box-shadow: none !important;
    text-decoration: underline;
    text-decoration-color: var(--chip);
    text-decoration-thickness: 4px;
  }
  .menu .label {
    margin: var(--s-4) 0 var(--s-2);
  }
  .wide {
    width: 100%;
    justify-content: flex-start;
    min-height: 48px;
  }
  .themes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: var(--frame);
  }
  .themes button {
    min-height: 48px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .themes button[aria-checked="true"] {
    background: var(--ink);
    color: var(--bg);
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: var(--s-5);
  }
</style>
<script>
  import "@/scripts/menu";
  import "@/scripts/theme";
  import "@/scripts/lens";
</script>
