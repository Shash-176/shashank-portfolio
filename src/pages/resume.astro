---
import Base from "@/layouts/Base.astro";
import Text from "@/components/Text.astro";
import { SITE } from "@/site";
import { hasPlaceholder } from "@/lib/rules";
const ready = !hasPlaceholder(SITE.resume.url);
---

<Base title="Résumé" sheet="Résumé" description="Shashank Maheshwar's résumé (PDF).">
  <div class="page">
    <h1>Résumé</h1>
    {ready ? (
      <p>
        <a class="btn primary" href={SITE.resume.url}>
          Download the résumé (PDF, {SITE.resume.size}, updated {SITE.resume.updated})
        </a>
      </p>
    ) : (
      <p class="ph">
        The PDF is not published yet: <Text value={SITE.resume.url} />.
      </p>
    )}
    <p>
      One page: technical skills; three projects (PlanProof, Smart Attendance and Saarthi, a Spring Boot onboarding
      system); education; research in progress; certification; leadership.
    </p>
    <p class="muted">
      The résumé is the one-page summary. The case studies on this site carry the evidence: each claim says how it was
      checked, when, and where to look.
    </p>
  </div>
</Base>
<style>
  .page {
    padding-top: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  h1 {
    font-size: var(--fs-title);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .muted {
    color: var(--muted);
    max-width: 60ch;
  }
  .ph {
    padding: 14px 16px;
    border: 1px dashed var(--strong);
  }
</style>
