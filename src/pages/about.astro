---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Annotated from "@/components/Annotated.astro";
import Avatar from "@/components/Avatar.astro";
import Ev from "@/components/Ev.astro";
import Text from "@/components/Text.astro";
import { SITE } from "@/site";
import { hasPlaceholder } from "@/lib/rules";

const CAP_ORDER = ["postgres", "python", "apis", "typescript", "testing", "retrieval"];
const caps = (await getCollection("capabilities")).sort((a, b) => CAP_ORDER.indexOf(a.id) - CAP_ORDER.indexOf(b.id));
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const roles = await getCollection("roles");
const edu = roles.filter((r) => r.data.kind === "education").sort((a, b) => b.data.start.localeCompare(a.data.start));
const leadership = roles.filter((r) => r.data.kind === "leadership");
const work = roles.filter((r) => r.data.kind === "work");
const short: Record<string, string> = {
  planproof: "PlanProof",
  "smart-attendance": "Attendance",
  "graph-rag": "RAG",
  "research-data-platform": "Data platform",
};
const resumeHref = hasPlaceholder(SITE.resume.url) ? "/resume" : SITE.resume.url;
---

<Base
  title="About"
  description="Shashank Maheshwar: MCA student in Mumbai building backend and data systems, mostly on PostgreSQL. Education, capabilities with evidence, leadership."
  sheet="About · 3 of 6"
  active="about"
>
  <div class="page">
    <Annotated as="section" labelledby="about-h" class="intro">
      <h1 id="about-h">About</h1>
      <p class="lead">
        I’m Shashank Maheshwar. I build backend and data systems, mostly on PostgreSQL, and I like them to say “cannot
        tell” when they cannot.
      </p>
      <p class="prose">
        I’m in the second year of an MCA at K. J. Somaiya Institute of Management in Mumbai, graduating in 2027. The
        projects on this site share one habit: every result is checked by something other than the thing that produced
        it.
      </p>
      <div class="actions">
        <a class="btn primary" href={resumeHref}>
          Résumé (PDF) · <Text value={SITE.resume.size} /> · updated <Text value={SITE.resume.updated} />
        </a>
        <a class="btn" href="#contact">
          Get in touch
        </a>
      </div>
      <Avatar slot="margin-top" size={220} caption="FIG. 0 — Base model, not yet a likeness." />
    </Annotated>

    {work.length > 0 && (
      <section class="block" aria-labelledby="exp-h">
        <h2 id="exp-h">Experience</h2>
        <ul class="ruled">
          {work.map((r) => (
            <li>
              <span class="mono">
                {r.data.start}–{r.data.end ?? "now"}
              </span>
              <span>
                <strong>{r.data.title}</strong>, {r.data.organisation}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Annotated as="section" labelledby="edu-h" class="block">
      <h2 id="edu-h">Education</h2>
      <ul class="ruled">
        {edu.map((r, i) => (
          <li>
            <span class="mono">
              {r.data.start} – {r.data.end}
            </span>
            <span>
              {i === 0 ? (
                <Ev id="edu">
                  <strong>{r.data.title}</strong>
                </Ev>
              ) : (
                <strong>{r.data.title}</strong>
              )}
              <br />
              {r.data.organisation}
              {r.data.summary && ` · ${r.data.summary}`}
            </span>
          </li>
        ))}
      </ul>
    </Annotated>

    <section class="block" aria-labelledby="cap-h">
      <h2 id="cap-h">Capabilities, with evidence</h2>
      <div class="table-scroll">
        <table class="caps">
          <caption class="label">
            ● substantial use, with evidence on the case study · ○ supporting use · no ratings, no logos
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {projects.map((p) => (
                <th scope="col">{short[p.id] ?? p.data.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {caps.map((c) => (
              <tr>
                <th scope="row">
                  <strong>{c.data.name}</strong>
                  <br />
                  <span class="muted">{c.data.description}</span>
                </th>
                {projects.map((p) => {
                  const sub = c.data.substantial.some((r) => r.id === p.id);
                  const sup = c.data.supporting.some((r) => r.id === p.id);
                  return (
                    <td>
                      {sub ? (
                        <a href={`/work/${p.id}`} aria-label={`${c.data.name}: substantial use in ${p.data.name}`}>
                          ●
                        </a>
                      ) : sup ? (
                        <a href={`/work/${p.id}`} aria-label={`${c.data.name}: supporting use in ${p.data.name}`}>
                          ○
                        </a>
                      ) : (
                        <span aria-label="not used">—</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="caps-list" aria-label="Capabilities by project">
        {caps.map((c) => (
          <li>
            <strong>{c.data.name}</strong>
            <span class="muted">{c.data.description}</span>
            <span class="where">
              {projects
                .filter((p) => c.data.substantial.some((r) => r.id === p.id))
                .map((p) => (
                  <a href={`/work/${p.id}`}>● {short[p.id] ?? p.data.name}</a>
                ))}
              {projects
                .filter((p) => c.data.supporting.some((r) => r.id === p.id))
                .map((p) => (
                  <a href={`/work/${p.id}`} class="sup">
                    ○ {short[p.id] ?? p.data.name}
                  </a>
                ))}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <Annotated as="section" labelledby="leadership" class="block two">
      <div>
        <h2 id="leadership">Leadership</h2>
        {leadership.map((r) => (
          <p>
            <Ev id="icon">
              <strong>{r.data.title}</strong>, {r.data.organisation}
            </Ev>
            . <Text value={r.data.summary} />{" "}
            <span class="muted">
              (<Text value={r.data.start} />)
            </span>
          </p>
        ))}
      </div>
      <div>
        <h2 id="cert-h">Certification</h2>
        <p>
          <Ev id="cert">
            <strong>IBM Professional Certificate</strong>: Deep Learning with PyTorch, Keras and TensorFlow
          </Ev>{" "}
          (Coursera, 2026).
        </p>
      </div>
    </Annotated>

    <section class="block" aria-labelledby="how-h">
      <h2 id="how-h">How I work</h2>
      <div class="three">
        <div>
          <h3>A claim is not a result.</h3>
          <p>If something says it is faster, I want to watch it run, on data built to break it.</p>
        </div>
        <div>
          <h3>Unknown is an answer.</h3>
          <p>I would sooner ship a system that says “cannot tell” than one that guesses neatly.</p>
        </div>
        <div>
          <h3>AI proposes. Checks decide.</h3>
          <p>I treat model output like any other untrusted input.</p>
        </div>
      </div>
    </section>

    <section id="ai-tools" class="block ai" aria-labelledby="ai-h">
      <h2 id="ai-h" class="label">
        How I use AI tools
      </h2>
      {SITE.aiStatement.approved ? (
        <p class="big">{SITE.aiStatement.text}</p>
      ) : (
        <p class="big">
          <span class="placeholder" data-placeholder="AI-tools statement: approve or rewrite">
            Draft, awaiting approval:
          </span>{" "}
          {SITE.aiStatement.text}
        </p>
      )}
      <p class="muted">One statement for the whole site. It is not repeated on project pages.</p>
    </section>

    <section class="block" aria-labelledby="res-h">
      <h2 id="res-h">Current research</h2>
      <a class="research" href="/research">
        <span>
          <strong>Usage-Aware Progressive Image Retention</strong>
          <br />
          <span class="muted">In progress · not published</span>
        </span>
        <span>Research →</span>
      </a>
    </section>
    <span id="contact"></span>
  </div>
</Base>
<style>
  .caps-list {
    display: none;
    list-style: none;
    padding: 0;
    border-top: var(--frame);
  }
  .caps-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    border-bottom: var(--hair);
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: 4px;
  }
  .where a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 10px;
    border: var(--frame);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .where a.sup {
    border-style: dashed;
  }
  @media (max-width: 767.98px) {
    .table-scroll:has(.caps) {
      display: none;
    }
    .caps-list {
      display: block;
    }
  }
  :global(.intro) {
    padding: var(--s-6) 0 var(--s-5);
  }
  h1 {
    font-size: var(--fs-title);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--s-4);
  }
  .lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-claim);
    line-height: 1.2;
    max-width: 30ch;
    margin-bottom: var(--s-4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s-5);
  }
  :global(.block) {
    margin-top: var(--s-7);
  }
  :global(.block) h2 {
    font-size: var(--fs-section);
    margin-bottom: var(--s-3);
  }
  .ruled {
    list-style: none;
    padding: 0;
    border-top: var(--frame);
  }
  .ruled li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px 20px;
    padding: 14px 0;
    border-bottom: var(--hair);
  }
  @media (min-width: 768px) {
    .ruled li {
      grid-template-columns: 150px 1fr;
    }
  }
  .ruled .mono {
    font-size: var(--fs-label);
    padding-top: 3px;
  }
  .caps {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    border-top: var(--frame);
  }
  .caps caption {
    caption-side: bottom;
    text-align: left;
    padding-top: 8px;
  }
  .caps th,
  .caps td {
    border-bottom: var(--hair);
    padding: 12px 8px 12px 0;
    text-align: left;
    vertical-align: middle;
  }
  .caps thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    color: var(--muted);
    border-bottom: var(--frame);
  }
  .caps td {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    width: 96px;
  }
  .caps td a {
    text-decoration: none;
    display: inline-block;
    min-width: 44px;
    min-height: 44px;
    line-height: 44px;
  }
  .caps td a:hover {
    background: var(--tint);
  }
  .muted {
    color: var(--muted);
    font-size: var(--fs-note);
    font-weight: 400;
  }
  :global(.two .content) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }
  @media (min-width: 768px) {
    :global(.two .content) {
      grid-template-columns: 1fr 1fr;
    }
  }
  .three {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    border-top: var(--frame);
    padding-top: var(--s-4);
  }
  @media (min-width: 768px) {
    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  h3 {
    font-size: 1.1875rem;
    margin-bottom: 6px;
  }
  .ai {
    border: var(--frame);
    background: var(--surface);
    padding: 18px 20px;
  }
  .ai h2 {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .big {
    font-size: 1.1875rem;
    margin-bottom: 6px;
  }
  .research {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: var(--frame);
    border-bottom: var(--frame);
    text-decoration: none;
  }
  .research:hover strong {
    text-decoration: underline;
  }
</style>
