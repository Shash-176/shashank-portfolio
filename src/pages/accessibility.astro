---
import Base from "@/layouts/Base.astro";
const criteria = [
  "Everything works with a keyboard alone, in visual order.",
  "Focus is always visible, in both themes.",
  "A skip link is the first thing on every page.",
  "One main heading per page; headings never skip a level.",
  "No information is carried by colour alone: every state has a shape and a word.",
  "Text contrast is at least 4.5:1 in both themes.",
  "Touch targets are at least 44 by 44 pixels.",
  "With reduced motion set, nothing moves; the avatar stays still.",
  "Every diagram has a text version in the page.",
  "Every exhibit works with buttons alone; no dragging, hovering or timing is required.",
  "Exhibit steps and the Evidence Lens announce their changes once, politely.",
  "Every evidence note is in the page without JavaScript.",
  "Pages work at 200% zoom and at 320 pixels wide without sideways scrolling.",
  "The avatar is decorative and hidden from screen readers.",
  "Reading order matches the visual order at every width.",
];
---

<Base
  title="Accessibility"
  description="Accessibility statement for Shashank Maheshwar's portfolio: what is tested, how, and known issues."
  sheet="Accessibility · 6 of 6"
>
  <div class="page doc">
    <h1>Accessibility</h1>
    <p class="lead">This site aims to meet WCAG 2.2 level AA. These are the checks it is built and tested against.</p>
    <ol class="crit">
      {criteria.map((c) => (
        <li>{c}</li>
      ))}
    </ol>
    <section aria-labelledby="test-h">
      <h2 id="test-h">How it is tested</h2>
      <p>
        Automated checks run on every page in both themes on each change, along with keyboard tests of the menu, the
        Evidence Lens, the diagrams and the exhibits. Screen-reader structure was reviewed by hand.
      </p>
    </section>
    <section aria-labelledby="known-h">
      <h2 id="known-h">Known issues</h2>
      <p>Wide tables, such as the evidence tables, scroll sideways inside their own box on small screens.</p>
    </section>
    <section aria-labelledby="contact-h">
      <h2 id="contact-h">Found a problem?</h2>
      <p>Please tell me, using the contact links below, and I will fix it.</p>
    </section>
  </div>
</Base>
<style>
  .doc {
    padding-top: var(--s-6);
    max-width: 860px;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  @media (min-width: 1280px) {
    .doc {
      margin-left: max(var(--gutter), calc((100vw - var(--page)) / 2));
    }
  }
  h1 {
    font-size: var(--fs-title);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lead {
    font-family: var(--font-display);
    font-size: var(--fs-claim);
    line-height: 1.2;
  }
  h2 {
    font-size: var(--fs-section);
    margin-bottom: var(--s-2);
    border-top: var(--frame);
    padding-top: var(--s-3);
  }
  .crit {
    padding-left: 1.6em;
  }
  .crit li {
    padding: 6px 0;
    border-bottom: var(--hair);
    max-width: 66ch;
  }
  p {
    max-width: 66ch;
  }
</style>
