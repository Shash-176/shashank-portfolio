---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource/atkinson-hyperlegible-next/latin-400.css";
import "@fontsource/atkinson-hyperlegible-next/latin-600.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/global.css";
// The four files the first screen uses, preloaded so they arrive with the stylesheet and do not shift text.
import fontDisplay from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import fontBody from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url";
import fontBodyStrong from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-600-normal.woff2?url";
import fontMono from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EvidenceList from "@/components/EvidenceList.astro";
import LensBar from "@/components/LensBar.astro";
import { SITE } from "@/site";
import { evidenceById } from "@/lib/evidence";
import { processEvidence, listHtml } from "@/lib/evidence-render";

interface Props {
  title: string;
  description?: string;
  sheet: string;
  active?: "work" | "about" | "research";
  og?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title,
  description = SITE.description,
  sheet,
  active,
  og = "/og/home.png",
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.role}` : `${title} — ${SITE.name}`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: Astro.site?.href,
  sameAs: [SITE.github],
  alumniOf: { "@type": "CollegeOrUniversity", name: "K. J. Somaiya Institute of Management" },
  homeLocation: { "@type": "Place", name: "Mumbai, India" },
};
// Evidence is numbered in document order after the body renders (src/lib/evidence-render.ts).
const all = await evidenceById();
const { html: main, order } = processEvidence(await Astro.slots.render("default"), all);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    {[fontDisplay, fontBody, fontBodyStrong, fontMono].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          const t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
          if (sessionStorage.getItem("lens") === "on") document.documentElement.dataset.lens = "on";
        } catch {
          /* storage blocked: defaults apply */
        }
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd ? [person, jsonLd] : person).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header active={active} />
    <main id="main" tabindex="-1">
      <Fragment set:html={main} />
    </main>
    <EvidenceList count={order.length} html={listHtml(order, all)} />
    <Footer sheet={sheet} order={order} />
    <LensBar />
  </body>
</html>
<style>
  main:focus {
    outline: none;
  }
</style>
